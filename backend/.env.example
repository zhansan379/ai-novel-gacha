# =============================================================
# AI 小说生成系统 - 后端环境变量示例
# 复制为同目录 .env 后生效：  copy .env.example .env
# 后端在 backend/ 目录运行，Settings(pydantic-settings) 从这里读 .env。
# 所有字段都有代码内默认值，可全部留空直接跑。
# 敏感值只放 .env，不要提交到 git。
# =============================================================

# 模型接入优先级：前端"设置面板"（存 SQLite Keychain）> 本文件（env 兜底）。
# 只要在页面设置面板填过，就无需在此填任何模型 Key。下面是 env 兜底示例（可选）：
# API_KEYS={"deepseek":"sk-替换成你的key"}

# ---------------- 模型接入（可选，env 兜底时按需打开）----------------
# 当前生效提供商标识；缺省 deepseek
# DEFAULT_PROVIDER=deepseek
# 默认聊天模型名；缺省 deepseek-chat
# DEFAULT_MODEL=deepseek-chat
# 各厂商 OpenAI 兼容 Base URL（JSON）；缺省用 OPENAI_COMPAT_BASE_URL
# BASE_URLS={"deepseek":"https://api.deepseek.com/v1"}
# 兜底 Base URL；缺省 https://api.deepseek.com/v1
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
# 单次模型调用超时（秒）；缺省 60
# LLM_TIMEOUT=60

# ---------------- 内置真实知识库（Chroma，按需打开）----------------
# Chroma 持久化目录（唯一事实来源，.gitignore 已忽略）；缺省 data/chroma
# CHROMA_PATH=data/chroma
# embedding 方式：n-gram（缺省，离线中文可用）| llm（外部 /embeddings，语义更强）
# EMBEDDING_MODE=n-gram
# llm 模式 embedding 模型名（复用当前模型服务 /embeddings）；留空自动回落 n-gram
# EMBEDDING_MODEL=
# 外部 embedding 超时（秒）；缺省 20
# EMBED_TIMEOUT=20

# ---------------- 联网检索补充（默认关，按需打开）----------------
# 检索提供商；缺省 tavily
# SEARCH_PROVIDER=tavily
# Tavily API Key；留空则关闭联网检索，只用 Chroma 向量库
# SEARCH_API_KEY=
# 检索超时（秒）；缺省 15
# SEARCH_TIMEOUT=15

# ---------------- 持久化 / 其他（按需打开）----------------
# SQLite 库路径；缺省 data/app.db
# DB_PATH=data/app.db
# APP_NAME=AI Novel Gacha
# VERSION=0.1.0

# ---------------- 公网多用户（按需打开，推荐）----------------
# 服务端机密：用于加密落库的模型 API Key。公网必须设置且与模型 Key 分开保管。
# 生成方式（安装 secure 组后）：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRET_KEY=任意的至少32字符长串（不经 Fernet 工具也可，代码会用其 sha256 派生密钥）
# 允许跨域的前端源（JSON 列表）。公网同域部署留空即为最严（禁止跨域）。
# CORS_ORIGINS=["https://novel.example.com"]

# ---------------- 异步开书任务 + 单书内部扇出（按需调，可选）----------------
# 全局同时运行的开书任务/扇出上限（保护厂商限流）；缺省 4
# TASK_CONCURRENCY=4
# 已完成/出错任务保活秒数，到期清扫；缺省 3600
# TASK_TTL_SECONDS=3600
# 最多保留的任务条数，超出淘汰最旧；缺省 200
# TASK_MAX_RETAINED=200
# 单书内部是否分波并行扇出（省墙钟时间但多耗 token）；缺省 true
# BOOK_FANOUT=true