# =============================================================
# AI 小说生成系统 - 后端环境变量示例
# 复制为同目录 .env 后生效：  copy .env.example .env
# 后端在 backend/ 目录运行，Settings(pydantic-settings) 从这里读 .env。
# 所有字段都有代码内默认值；除 API_KEYS 外均可留空不动，按需打开再填。
# 敏感值只放 .env，不要提交到 git。
# =============================================================

# 必填：至少一个模型厂商的 API Key（JSON 对象，引号不要用反斜杠转义）
API_KEYS={"deepseek":"sk-替换成你的key"}

# ---------------- 模型接入（按需打开）----------------
# 当前生效提供商标识；缺省 deepseek
# DEFAULT_PROVIDER=deepseek
# 默认聊天模型名；缺省 deepseek-chat
# DEFAULT_MODEL=deepseek-chat
# 各厂商 OpenAI 兼容 Base URL（JSON）；缺省用 OPENAI_COMPAT_BASE_URL
# BASE_URLS={"deepseek":"https://api.deepseek.com/v1"}
# 兜底 Base URL；缺省 https://api.deepseek.com/v1
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
# 单次模型调用超时（秒）；缺省 60
# LLM_TIMEOUT=60

# ---------------- 内置真实知识库（Chroma，按需打开）----------------
# Chroma 持久化目录（唯一事实来源，.gitignore 已忽略）；缺省 data/chroma
# CHROMA_PATH=data/chroma
# embedding 方式：n-gram（缺省，离线中文可用）| llm（外部 /embeddings，语义更强）
# EMBEDDING_MODE=n-gram
# llm 模式 embedding 模型名（复用当前模型服务 /embeddings）；留空自动回落 n-gram
# EMBEDDING_MODEL=
# 外部 embedding 超时（秒）；缺省 20
# EMBED_TIMEOUT=20

# ---------------- 联网检索补充（默认关，按需打开）----------------
# 检索提供商；缺省 tavily
# SEARCH_PROVIDER=tavily
# Tavily API Key；留空则关闭联网检索，只用 Chroma 向量库
# SEARCH_API_KEY=
# 检索超时（秒）；缺省 15
# SEARCH_TIMEOUT=15

# ---------------- 持久化 / 其他（按需打开）----------------
# SQLite 库路径；缺省 data/app.db
# DB_PATH=data/app.db
# APP_NAME=AI Novel Gacha
# VERSION=0.1.0